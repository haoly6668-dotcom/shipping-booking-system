# setup_database.py creates a separate SQL login and random local secrets.
# Never use sa/db_owner as the runtime account.
SECRET_KEY=replace_with_random_generated_secret
DB_CONNECTION_STRING='DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=HarborBooking;UID=HarborBooking_app;PWD=replace;Encrypt=yes;TrustServerCertificate=yes'
PORT=5000
HTTPS_ONLY=0
